# Add this as a separate server block to the host Nginx configuration.
# Replace mealset.example with your domain and 8080 if LANDING_PORT was changed.
# Configure HTTPS on the host proxy after DNS points to the VPS.
server {
    listen 80;
    server_name mealset.example;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
