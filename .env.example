# Replace with the real domain BEFORE building. This is build-time SEO metadata.
SITE_URL=https://mealset.example

# Default: reachable only by a reverse proxy on the same VPS.
LANDING_BIND_IP=127.0.0.1
LANDING_PORT=8080

# Set to a release name or commit SHA to retain an identifiable Docker image.
LANDING_IMAGE_TAG=local
